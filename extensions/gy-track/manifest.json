{
  "manifest_version": 3,
  "name": "GY Track",
  "version": "1.0.1",
  "description": "George Yachts email tracking for the emails George writes in Gmail. Private, no third parties.",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["https://mail.google.com/*", "https://command.georgeyachts.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "GY Track", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["hmac.js", "gmail.js"], "run_at": "document_idle" },
    { "matches": ["https://command.georgeyachts.com/*"], "js": ["command.js"], "run_at": "document_idle" }
  ]
}
